# Copy to ".env" for local dev. Trên server thật systemd nạp qua EnvironmentFile
# (xem deploy/tinhban.service + deploy/README.md) — KHÔNG commit file .env.

# Đường dẫn SQLite. Dùng "sqlite:<path>?mode=rwc" để tự tạo file nếu thiếu.
# Dev local: ./data/tinhban.db (tạo thư mục data/ tự động).
# Server: dùng đường dẫn tuyệt đối, vd: sqlite:/var/lib/tinhban/tinhban.db?mode=rwc
DATABASE_URL=sqlite:data/tinhban.db?mode=rwc

# Port Axum/Dioxus serve bind. Mặc định 8080.
PORT=8080

# IP bind. "127.0.0.1" = chỉ truy cập localhost (tốt nhất cho tailscale serve).
# Đặt "0.0.0.0" nếu muốn nghe trên mọi interface (cẩn thận nếu server có public IP).
IP=127.0.0.1

# tracing filter. "info" đủ cho journalctl. Thêm "debug,tinhban_api=trace" để verbose.
RUST_LOG=info,tower_http=info